# LLM provider: gemini (default) | openai | anthropic (Claude)
LLM_PROVIDER=gemini

# Gemini API Key (required unless using MOCK_LLM mode)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI backend (used only when LLM_PROVIDER=openai — SDK loads lazily)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic / Claude backend (used only when LLM_PROVIDER=anthropic — SDK loads lazily)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Set MOCK_LLM=true to run the full browser pipeline with canned AI responses
# (no API key required) — handy for testing and as a demo fallback.
MOCK_LLM=false

# Resume path (required for apply command)
RESUME_PATH=./data/resumes/placeholder.txt

# Browser settings
HEADLESS=false
SLOW_MO=100

# Database
DB_PATH=./data/applyflow.db

# webcmd browser layer (optional — auto-resolves to vendored webcmd/ if empty)
WEBCMD_PATH=
WEBCMD_PROFILE=applyflow

# Dedicated browser worker (local defaults; replace with hosted URLs in production)
PORT=8080
WORKER_URL=http://localhost:8080/apply
WORKER_SHARED_SECRET=replace-with-a-local-demo-secret

# Worker -> Next.js progress callback
PROGRESS_CALLBACK_URL=http://localhost:3000/api/apply/status
PROGRESS_CALLBACK_SECRET=replace-with-the-same-local-demo-secret
