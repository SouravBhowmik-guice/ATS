# Gemini API Key (required unless using MOCK_LLM mode)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash

# Set MOCK_LLM=true to run the full browser pipeline with canned AI responses
# (no API key required) — handy for testing and as a demo fallback.
MOCK_LLM=true

# Resume path (required for apply command)
RESUME_PATH=./data/resumes/placeholder.txt

# Browser settings
HEADLESS=false
SLOW_MO=100

# Database
DB_PATH=./data/applyflow.db

# webcmd browser layer (optional — auto-resolves to vendored webcmd/ if empty)
WEBCMD_PATH=
WEBCMD_PROFILE=applyflow
